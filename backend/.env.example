# Connection string del Session pooler (Supabase -> Connect)
# Reemplaza [YOUR-PASSWORD] por la contraseña de la base de datos
DATABASE_URL=

# Supabase -> Project Settings -> Data API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

PORT=3000
FRONTEND_URL=http://localhost:5173

# Carpeta privada (ruta absoluta) para los PDF y Word exportados. Vacía = backend/almacenamiento/exportaciones
# En un despliegue debe ser almacenamiento persistente y no público.
EXPORTACIONES_DIR=

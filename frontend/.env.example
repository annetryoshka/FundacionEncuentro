# Copia este archivo como .env.local (no se sube a Git).

# URL base de la API. En desarrollo deja /api: Vite lo reenvía al backend.
VITE_API_URL=/api

# A dónde reenvía Vite las peticiones /api en desarrollo (backend NestJS).
VITE_API_PROXY=http://localhost:3000

# true = API simulada en el navegador, sin backend (solo funciona con npm run dev).
# Es lo mismo que usar: npm run dev:simulado
VITE_API_SIMULADA=false
